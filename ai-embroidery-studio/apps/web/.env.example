# FastAPI base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
# "dev" (type a name) or "supabase" (Supabase Auth; must match the API's EMB_AUTH_MODE)
NEXT_PUBLIC_AUTH_MODE=dev
# Required when NEXT_PUBLIC_AUTH_MODE=supabase (public anon key - never the service-role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
